{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Write|Edit",
      "hooks": [{
        "type": "command",
        "command": "node ${CLAUDE_PROJECT_DIR}/scripts/tdd-guard/adapters/claude.mjs pre-edit",
        "timeout": 10,
        "statusMessage": "공통 TDD proof 확인 중"
      }]
    }],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/scripts/tdd-guard/adapters/claude.mjs post-edit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
