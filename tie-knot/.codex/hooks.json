{
  "description": "Run the shared TDD Guard. Review trust with /hooks after every change.",
  "hooks": {
    "PreToolUse": [{
      "matcher": "^apply_patch$",
      "hooks": [{
        "type": "command",
        "command": "node scripts/tdd-guard/codex-adapter.mjs pre-edit",
        "timeout": 10,
        "statusMessage": "Checking shared TDD proof"
      }]
    }],
    "PostToolUse": [{
      "matcher": "^apply_patch$",
      "hooks": [{
        "type": "command",
        "command": "node scripts/tdd-guard/codex-adapter.mjs post-edit",
        "timeout": 10
      }]
    }]
  }
}
